{
  "name": "fast-food-manufacturing-control",
  "version": "0.1.0",
  "private": true,
  "description": "Development scaffold for auditable food manufacturing workflows",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
